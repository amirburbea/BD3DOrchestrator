<Window x:Class="BD3DOrchestrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BD3DOrchestrator"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="BD3D2MK3D Orchestrator" Height="740" Width="800"
        Icon="app.ico" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance {x:Type local:MainWindowViewModel}}">
    <Window.Resources>
        <local:NegatedBooleanConverter x:Key="NegatedBooleanConverter" />
        <local:IsNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" Invert="True" />
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Drop Zone Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="🎬 Drag &amp; Drop 3D Movie Folder or .MKV File Here" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Job.InputPath}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Rectangle Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1.5" StrokeDashArray="5 3" RadiusX="8" RadiusY="8" IsHitTestVisible="False"/>
        </Grid>
        <!-- Movie Details & Auto-Detection Info -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="True">
                    <TextBlock Text="Movie Title: " FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Job.MovieTitle, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" FontWeight="SemiBold" Margin="4,0,10,0"
                             IsEnabled="{Binding IsRunning, Converter={StaticResource NegatedBooleanConverter}}"/>
                </DockPanel>
                <TextBlock Grid.Row="1" Text="{Binding Job.DetectionReason}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0"/>
                <Button Grid.Column="1" Grid.RowSpan="2" Content="Browse..." Click="BtnBrowse_Click" VerticalAlignment="Center" IsEnabled="{Binding IsRunning, Converter={StaticResource NegatedBooleanConverter}}"/>
            </Grid>
        </Border>
        <!-- Configuration Options -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel IsEnabled="{Binding IsRunning, Converter={StaticResource NegatedBooleanConverter}}">
                <TextBlock Text="Automated Pipeline Settings" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                <CheckBox IsChecked="{Binding Job.ApplyAvsTweak}"
                          Content="Inject OLED Contrast &amp; Saturation AVS Tweak: Tweak(sat=1.1, cont=1.05)"
                          ToolTip="Defaulted on older animation titles; later movies tend to be made for HDR and enabling could blow out contrast." />
                <CheckBox IsChecked="{Binding Job.UseExtraQuality}"
                          IsEnabled="{Binding IsExtraQualityAvailable}"
                          Content="{Binding ExtraQualityLabel}"
                          ToolTip="One CRF step below the default; all other settings stay the same."/>
            </StackPanel>
        </Border>
        <!-- Steal Tracks from Previous Encode -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel IsEnabled="{Binding IsRunning, Converter={StaticResource NegatedBooleanConverter}}">
                <TextBlock Text="Steal Tracks from Previous Encode" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Donor File:" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               ToolTip="Select a previously encoded .mkv or .mks file to steal audio and/or subtitle tracks from."/>
                    <TextBox Grid.Column="1" Text="{Binding Job.StealPath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" Margin="0,0,6,0" IsReadOnly="True"
                             ToolTip="Optional .mkv or .mks file to steal tracks from"/>
                    <Button Grid.Column="2" Content="Browse..." Click="BtnBrowseSteal_Click" Margin="0,0,6,0"/>
                    <Button Grid.Column="3" Content="Clear" Click="BtnClearSteal_Click"
                            IsEnabled="{Binding Job.StealPath, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox IsChecked="{Binding Job.StealAudio}"
                              IsEnabled="{Binding Job.DonorHasAudio}"
                              Content="Audio"
                              Margin="0,0,16,0"
                              ToolTip="Uncheck audio in BD3D2MK3D and mux audio tracks from the donor file instead."/>
                    <CheckBox IsChecked="{Binding Job.StealSubtitles}"
                              IsEnabled="{Binding Job.DonorHasSubtitles}"
                              Content="Subtitles"
                              ToolTip="Uncheck subtitles in BD3D2MK3D and mux subtitle tracks from the donor file instead."/>
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- Log output: a read-only TextBox so lines can be selected and copied across rows; MainWindow caps its length.
             Deliberately a fixed dark terminal in both light and dark mode, not theme-colored. -->
        <Border Grid.Row="4" Background="#0C0C0C" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" ClipToBounds="True">
            <TextBox x:Name="TxtLog" IsReadOnly="True" IsUndoEnabled="False" TextWrapping="NoWrap"
                     Background="Transparent" BorderThickness="0" Padding="8,6"
                     FontFamily="Consolas" FontSize="12" Foreground="#4AF626"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <!-- Bare template: no Fluent hover/focus background or accent underline, just the scrolling text. -->
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"/>
                        </Border>
                    </ControlTemplate>
                </TextBox.Template>
                <TextBox.Resources>
                    <!-- Fluent collapses scrollbars to a hairline until hovered; these stay a normal width all the time. -->
                    <Style x:Key="LogScrollThumb" TargetType="Thumb">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="Bd" Background="#4A4A4A" CornerRadius="3" Margin="3"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#6E6E6E"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#8C8C8C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="LogScrollPage" TargetType="RepeatButton">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="IsTabStop" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Background" Value="#161616"/>
                        <Setter Property="Width" Value="14"/>
                        <Setter Property="MinWidth" Value="14"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Border Background="{TemplateBinding Background}">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource LogScrollPage}" Command="ScrollBar.PageUpCommand"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource LogScrollThumb}"/>
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource LogScrollPage}" Command="ScrollBar.PageDownCommand"/>
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="Height" Value="14"/>
                                <Setter Property="MinHeight" Value="14"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Border Background="{TemplateBinding Background}">
                                                <Track x:Name="PART_Track">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Style="{StaticResource LogScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb Style="{StaticResource LogScrollThumb}"/>
                                                    </Track.Thumb>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Style="{StaticResource LogScrollPage}" Command="ScrollBar.PageRightCommand"/>
                                                    </Track.IncreaseRepeatButton>
                                                </Track>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Resources>
            </TextBox>
        </Border>
        <!-- Single Action Button -->
        <Grid Grid.Row="5">
            <Button Content="{Binding ActionButtonText}"
                    Style="{DynamicResource AccentButtonStyle}"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource NegatedBooleanConverter}}"
                    Click="BtnAutoRunAll_Click" FontSize="14" FontWeight="SemiBold" Padding="16,10" HorizontalAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
