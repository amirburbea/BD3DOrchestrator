<Window x:Class="BD3DOrchestrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BD3DOrchestrator"
        Title="BD3D2MK3D Orchestrator &amp; Assistant (All-in-One)" Height="660" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#181824" Foreground="#ECEFF4"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5E9F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3B4252"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Drop Zone Header -->
        <Border Grid.Row="0" BorderBrush="#434C5E" BorderThickness="2" CornerRadius="8" Background="#242933" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="🎬 Drag &amp; Drop 3D Movie Folder or .MKV File Here" FontSize="16" FontWeight="Bold" Foreground="#88C0D0" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Job.InputPath}" FontSize="12" Foreground="#D8DEE9" HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- Movie Details & Auto-Detection Info -->
        <Border Grid.Row="1" Background="#2E3440" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" IsEnabled="{Binding CanExecute}">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="Movie Title: " FontSize="14" FontWeight="Bold" Foreground="#88C0D0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Job.MovieTitle, UpdateSourceTrigger=PropertyChanged}" FontSize="14" FontWeight="Bold" Background="#1B1E27" Foreground="#ECEFF4" BorderBrush="#4C566A" Padding="4,2" Margin="4,0,10,0"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Job.DetectionReason}" FontSize="12" Foreground="#81A1C1" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Browse..." Click="BtnBrowse_Click" VerticalAlignment="Center" IsEnabled="{Binding CanExecute}"/>
            </Grid>
        </Border>

        <!-- Configuration Options -->
        <Border Grid.Row="2" Background="#2E3440" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel IsEnabled="{Binding CanExecute}">
                <TextBlock Text="Automated Pipeline Settings" FontSize="14" FontWeight="Bold" Foreground="#EBCB8B" Margin="0,0,0,6"/>

                <CheckBox IsChecked="{Binding Job.ConvertDtsToEac3}"
                          Content="Auto-convert DTS audio to EAC3 5.1 (640k Gain-Safe Fold via FFmpeg)"/>

                <CheckBox IsChecked="{Binding Job.ApplyAvsTweak}"
                          Content="Inject OLED Contrast &amp; Saturation AVS Tweak: Tweak(sat=1.1, cont=1.05)"/>

                <CheckBox IsChecked="{Binding Job.IngestCompanions}"
                          Content="Auto-ingest companion audio/subtitles (.mka, .mks, .ec3, .sup) into final MKV"/>

                <CheckBox IsChecked="{Binding Job.KillMkvinfoHangs}"
                          Content="Watchdog: Kill mkvinfo.exe automatically if it freezes search (> 10 sec)"/>
            </StackPanel>
        </Border>

        <!-- Log output: a read-only TextBox so lines can be selected and copied across rows; MainWindow caps its length -->
        <Border Grid.Row="3" Background="#111219" CornerRadius="8" BorderBrush="#2E3440" BorderThickness="1" Margin="0,0,0,12">
            <TextBox x:Name="TxtLog" IsReadOnly="True" IsUndoEnabled="False" TextWrapping="NoWrap"
                     Background="Transparent" BorderThickness="0" Padding="4,2"
                     FontFamily="Consolas" FontSize="12" Foreground="#A3BE8C"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Single Action Button -->
        <Grid Grid.Row="4">
            <Button Content="{Binding ActionButtonText}"
                    IsEnabled="{Binding CanExecute}"
                    Click="BtnAutoRunAll_Click" Background="#A3BE8C" Foreground="#1E232A" FontSize="14" FontWeight="Bold" HorizontalAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
